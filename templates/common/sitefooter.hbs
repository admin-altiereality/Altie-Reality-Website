<footer class="site-footer">
  <div class="container container--wide">
    <div class="footer__grid">
      <div class="footer__about">
        <a class="brand" href="/">
          <img src="/assets/img/logo.png" alt="" width="30" height="30" />
          <span>Altie Reality</span>
        </a>
        <p>{{company.boilerplate}}</p>

        <div class="social-row">
          {{#each social}}
          <a href="{{this.url}}" target="_blank" rel="noopener noreferrer" aria-label="Altie Reality on {{this.name}}">
            {{#if (eq this.icon "linkedin")}}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05a4.2 4.2 0 0 1 3.77-2.07c4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21h-4z"/></svg>
            {{/if}}
            {{#if (eq this.icon "youtube")}}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.6-.46-5.33a2.78 2.78 0 0 0-1.95-1.97C18.88 4.25 12 4.25 12 4.25s-6.88 0-8.59.45A2.78 2.78 0 0 0 1.46 6.67C1 8.4 1 12 1 12s0 3.6.46 5.33a2.78 2.78 0 0 0 1.95 1.97c1.71.45 8.59.45 8.59.45s6.88 0 8.59-.45a2.78 2.78 0 0 0 1.95-1.97C23 15.6 23 12 23 12zM9.75 15.5v-7l6 3.5z"/></svg>
            {{/if}}
            {{#if (eq this.icon "instagram")}}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 3.24a6.6 6.6 0 1 0 0 13.2 6.6 6.6 0 0 0 0-13.2zm0 10.88a4.28 4.28 0 1 1 0-8.56 4.28 4.28 0 0 1 0 8.56zm8.4-11.14a1.54 1.54 0 1 1-3.08 0 1.54 1.54 0 0 1 3.08 0z"/></svg>
            {{/if}}
            {{#if (eq this.icon "facebook")}}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/></svg>
            {{/if}}
          </a>
          {{/each}}
        </div>
      </div>

      <div class="footer__col">
        <h3>Solutions</h3>
        <ul>
          {{#each products}}
          <li>
            <a href="{{this.href}}" target="_blank" rel="noopener noreferrer">{{this.name}}</a>
          </li>
          {{/each}}
        </ul>
      </div>

      <div class="footer__col">
        <h3>Industries</h3>
        <ul>
          {{#each industries}}
          <li><a href="{{this.route}}">{{this.name}}</a></li>
          {{/each}}
        </ul>
      </div>

      <div class="footer__col">
        <h3>Company</h3>
        <ul>
          <li><a href="/company">About us</a></li>
          <li><a href="/technology">Technology</a></li>
          <li><a href="/blog">Journey</a></li>
          <li><a href="/career">Careers</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>

        <div class="footer__contact" style="margin-top: var(--s7);">
          <h3>Get in touch</h3>
          <p>{{company.address.city}}, {{company.address.region}} — {{company.address.country}}</p>
          <p style="margin-top: var(--s4);">
            <a href="tel:+918619953434">{{company.phone}}</a><br />
            <a href="mailto:{{company.email}}">{{company.email}}</a>
          </p>
        </div>
      </div>
    </div>

    <div class="footer__bar">
      <p>&copy; {{year}} {{company.legalName}}. All rights reserved.</p>
      <nav aria-label="Legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/termsandconditions">Terms of Service</a>
        <a href="/reliconnectprivacy">ReliconnectVR Privacy</a>
        <a href="/creditsandlicenses">Credits &amp; Licenses</a>
      </nav>
    </div>
  </div>
</footer>

<button class="to-top" type="button" aria-label="Back to top">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script src="/design/site.js?v={{v}}" defer></script>
