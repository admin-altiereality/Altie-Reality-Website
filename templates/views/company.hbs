<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  {{> sitehead}}
  <script type="application/ld+json">{{{jsonld schema}}}</script>
</head>

<body>
  {{> siteheader}}

  <main id="main">
    <section class="page-hero">
      <div class="container container--wide">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs">
            <li><a href="/">Home</a></li>
            <li>Company</li>
          </ol>
        </nav>

        <div class="page-hero__inner">
          <p class="eyebrow">{{company.legalName}}</p>
          <h1 class="display">An XR company built in Jaipur, shipping to the world.</h1>
          <p class="lead" style="margin-top: var(--s6); max-width: 64ch;">
            {{company.boilerplate}}
          </p>
        </div>
      </div>
    </section>

    <section class="section section--flush-top">
      <div class="container container--wide">
        <div class="split">
          <div data-reveal>
            <p class="eyebrow">Why we exist</p>
            <h2>Immersive technology should not stop at the metros.</h2>
            <p class="lead" style="margin-top: var(--s5);">
              LearnXR is built to make immersive education accessible, inclusive
              and impactful across Tier 1, Tier 2 and Tier 3 cities. That
              constraint shapes every technical decision we make: which devices
              we target, how much bandwidth a lesson needs, and what a school
              has to buy before a student can put a headset on.
            </p>
            <p style="margin-top: var(--s4);">
              It is also why we build hardware. XRtouch exists because
              interacting with XR content should not require the most expensive
              controller in the room.
            </p>
          </div>

          <div data-reveal>
            <div class="frame frame--ratio-4-3">
              <img src="/media/assets/img/teamabout.webp" alt="The Altie Reality team" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Leadership</p>
          <h2>The team.</h2>
        </div>

        <div class="grid grid-3">
          {{#each team}}
          <div class="person" data-reveal="stagger">
            <div class="person__photo">
              <img src="{{this.image}}" alt="{{this.name}}, {{this.role}}" loading="lazy" />
            </div>
            <h3 style="font-size: 1.15rem;">{{this.name}}</h3>
            <span class="person__role">{{this.role}}</span>
            <p class="person__cred">{{this.credential}}</p>
          </div>
          {{/each}}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Ecosystem</p>
          <h2>Recognised, funded and accelerated.</h2>
          <p class="lead">
            Each of these is a programme that selected us or a grant we received.
            The full record is on our journey page.
          </p>
        </div>

        <div class="recog" data-reveal>
          {{#each recognition}}
          {{#if this.href}}
          <a class="recog__item" href="{{this.href}}" target="_blank" rel="noopener noreferrer">
            <img class="recog__logo" src="{{this.image}}" alt="{{this.name}}" loading="lazy" width="130" height="34" />
            <span class="recog__name">{{this.name}}</span>
            <span class="recog__note">{{this.note}}</span>
          </a>
          {{else}}
          <div class="recog__item">
            <img class="recog__logo" src="{{this.image}}" alt="{{this.name}}" loading="lazy" width="130" height="34" />
            <span class="recog__name">{{this.name}}</span>
            <span class="recog__note">{{this.note}}</span>
          </div>
          {{/if}}
          {{/each}}
        </div>

        <div class="grid grid-2" style="margin-top: var(--s9); gap: var(--s5);">
          {{#each featured}}
          <article class="card" data-reveal="stagger">
            <div class="entry__meta">
              <span class="pill">{{this.kind}}</span>
              <span class="entry__date">{{this.date}}</span>
            </div>
            <h3>{{this.title}}</h3>
            <p style="margin-top: var(--s3);">{{this.summary}}</p>
          </article>
          {{/each}}
        </div>

        <div style="margin-top: var(--s8);" data-reveal>
          <a class="btn btn--ghost" href="/blog">Read the full journey</a>
        </div>
      </div>
    </section>

    <section class="section section--raised">
      <div class="container container--wide">
        <div class="split">
          <div data-reveal>
            <p class="eyebrow">Where we are</p>
            <h2>Bhamashah Technohub, Jaipur.</h2>
            <address class="lead" style="font-style: normal; margin-top: var(--s5);">
              {{company.legalName}}<br />
              {{company.address.line1}}<br />
              {{company.address.line2}}, {{company.address.city}} {{company.address.postalCode}}<br />
              {{company.address.country}}
            </address>
            <div class="btn-row" style="margin-top: var(--s6);">
              <a class="btn btn--ghost" href="{{company.address.maps}}" target="_blank" rel="noopener noreferrer">
                View on Google Maps
              </a>
              <a class="btn btn--ghost" href="/career">Open roles</a>
            </div>
          </div>

          <div data-reveal>
            <div class="frame frame--ratio-4-3">
              <img src="/media/images/avgcxr.webp" alt="Altie Reality at Bhamashah Technohub, Jaipur" loading="lazy" />
            </div>
          </div>
        </div>

        <div style="margin-top: var(--s10);">
          {{> ctaband}}
        </div>
      </div>
    </section>
  </main>

  {{> sitefooter}}
</body>
</html>
