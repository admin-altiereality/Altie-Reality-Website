<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  {{> sitehead}}
  <script type="application/ld+json">{{{jsonld schema}}}</script>
</head>

<body>
  {{> siteheader}}

  <main id="main">
    <section class="page-hero">
      <div class="container container--wide">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs">
            <li><a href="/">Home</a></li>
            <li>Careers</li>
          </ol>
        </nav>

        <div class="page-hero__inner">
          <p class="eyebrow">Careers</p>
          <h1 class="display">Build things people put on their face.</h1>
          <p class="lead" style="margin-top: var(--s6); max-width: 62ch;">
            We are a small team, which means interns here ship production work
            rather than shadowing it. Whether you are experienced or just
            starting out, you will own something real.
          </p>

          <div class="btn-row" style="margin-top: var(--s7);">
            <a class="btn btn--primary btn--lg" href="{{company.careersForm}}" target="_blank" rel="noopener noreferrer">
              Apply now
            </a>
            <a class="btn btn--ghost btn--lg" href="/company">About the company</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--flush-top">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Open positions</p>
          <h2>Internships.</h2>
        </div>

        <div class="grid grid-3">
          {{#each roles}}
          <article class="card" data-reveal="stagger">
            <div class="frame frame--ratio-16-9" style="margin: calc(-1 * clamp(1.5rem, 2.4vw, 2rem)) calc(-1 * clamp(1.5rem, 2.4vw, 2rem)) clamp(1.5rem, 2.4vw, 2rem); border-radius: var(--r-lg) var(--r-lg) 0 0; border-width: 0 0 1px 0;">
              <img src="{{this.image}}" alt="{{this.title}}" loading="lazy" />
            </div>
            <span class="pill" style="margin-bottom: var(--s4);">{{this.type}}</span>
            <h3>{{this.title}}</h3>
            <p style="margin-top: var(--s3);">{{this.body}}</p>
            <a
              class="link-arrow"
              style="margin-top: var(--s5);"
              href="{{../company.careersForm}}"
              target="_blank"
              rel="noopener noreferrer"
            >
              Apply for {{this.title}}
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </article>
          {{/each}}
        </div>
      </div>
    </section>

    <section class="section section--paper">
      <div class="container container--wide">
        <div class="split">
          <div data-reveal>
            <p class="eyebrow">Precedent</p>
            <h2>Our interns have come from BITS Pilani.</h2>
            <p class="lead" style="margin-top: var(--s5);">
              In May 2024, students from BITS Pilani Practice School joined the
              Altie Reality Summer Internship Program and worked on LearnXR
              through the course of their placement.
            </p>
            <a class="link-arrow" href="/blog" style="margin-top: var(--s6);">
              See the full journey
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div data-reveal>
            <div class="frame frame--ratio-16-9">
              <img src="/media/images/bitspilani.webp" alt="BITS Pilani Practice School interns at Altie Reality" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--wide">
        <div class="cta-band" data-reveal>
          <p class="eyebrow eyebrow--plain" style="justify-content: center;">Apply</p>
          <h2>Nothing here fits?</h2>
          <p class="lead">
            Send us what you have built. We read everything that comes through
            the form.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary btn--lg" href="{{company.careersForm}}" target="_blank" rel="noopener noreferrer">
              Open the application form
            </a>
            <a class="btn btn--ghost btn--lg" href="mailto:{{company.email}}">Email us</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  {{> sitefooter}}
</body>
</html>
