<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  {{> sitehead}}
  <meta name="robots" content="noindex" />
</head>

<body>
  {{> siteheader}}

  <main id="main">
    <section class="page-hero" style="min-height: 70vh; display: flex; align-items: center;">
      <div class="container container--wide">
        <div class="page-hero__inner">
          <p class="eyebrow">Error 404</p>
          <h1 class="display">This page is not in our space.</h1>
          <p class="lead" style="margin-top: var(--s6); max-width: 54ch;">
            The page you are looking for does not exist, or it has moved. Here
            are the places most people are heading.
          </p>

          <div class="btn-row" style="margin-top: var(--s7);">
            <a class="btn btn--primary btn--lg" href="/">Back to home</a>
            <a class="btn btn--ghost btn--lg" href="/products/learnxr">Explore LearnXR™</a>
          </div>
        </div>

        <div class="grid grid-4" style="margin-top: var(--s10);">
          <a class="card card--link" href="/products/learnxr">
            <h3 style="font-size: 1.05rem;">Products</h3>
            <p style="margin-top: var(--s3);">LearnXR, XRtouch and the rest of the stack.</p>
          </a>
          <a class="card card--link" href="/technology">
            <h3 style="font-size: 1.05rem;">Technology</h3>
            <p style="margin-top: var(--s3);">The capabilities behind what we ship.</p>
          </a>
          <a class="card card--link" href="/blog">
            <h3 style="font-size: 1.05rem;">Journey</h3>
            <p style="margin-top: var(--s3);">Programmes, grants and product launches.</p>
          </a>
          <a class="card card--link" href="/contact">
            <h3 style="font-size: 1.05rem;">Contact</h3>
            <p style="margin-top: var(--s3);">Talk to the team in Jaipur.</p>
          </a>
        </div>
      </div>
    </section>
  </main>

  {{> sitefooter}}
</body>
</html>
