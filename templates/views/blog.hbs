  <!-- Blog Search Functionality -->
  <style>
    /* Search functionality styling */
    #blog-search-input {
      width: 100%;
      padding: 8px 12px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 14px;
    }
    
    #blog-search-input:focus {
      outline: none;
      border-color: #4154f1;
      box-shadow: 0 0 0 2px rgba(65, 84, 241, 0.2);
    }
    
    .search-form button {
      background: #4154f1;
      color: white;
      border: none;
      padding: 8px 12px;
      border-radius: 4px;
      cursor: pointer;
      transition: background-color 0.3s;
    }
    
    .search-form button:hover {
      background: #2c3e50;
    }
    
    .entry {
      transition: opacity 0.3s ease;
    }
    
    .entry[style*="display: none"] {
      opacity: 0;
    }
    
    .entry[style*="display: block"] {
      opacity: 1;
    }
    
    #no-results-message {
      margin-top: 20px;
      padding: 15px;
      border-radius: 5px;
    }
    
    .sidebar-item.categories ul li a {
      transition: all 0.3s ease;
    }
  </style>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const searchForm = document.getElementById('blog-search-form');
      const searchInput = document.getElementById('blog-search-input');
      const blogEntries = document.querySelectorAll('.entries .entry');
      const achievementsList = document.querySelectorAll('.sidebar-item.categories ul li a');
      
      // Search functionality
      function performSearch(searchTerm) {
        const term = searchTerm.toLowerCase().trim();
        
        if (term === '') {
          // Show all entries if search is empty
          blogEntries.forEach(entry => {
            entry.style.display = 'block';
          });
          return;
        }
        
        let foundResults = false;
        
        // Search through blog entries
        blogEntries.forEach(entry => {
          const title = entry.querySelector('.entry-title a')?.textContent.toLowerCase() || '';
          const content = entry.querySelector('.entry-content')?.textContent.toLowerCase() || '';
          const sectionId = entry.closest('section')?.id || '';
          
          if (title.includes(term) || content.includes(term) || sectionId.includes(term)) {
            entry.style.display = 'block';
            foundResults = true;
          } else {
            entry.style.display = 'none';
          }
        });
        
        // Highlight matching achievements in sidebar
        achievementsList.forEach(link => {
          const linkText = link.textContent.toLowerCase();
          if (linkText.includes(term)) {
            link.style.backgroundColor = '#f0f8ff';
            link.style.padding = '5px 10px';
            link.style.borderRadius = '3px';
          } else {
            link.style.backgroundColor = '';
            link.style.padding = '';
            link.style.borderRadius = '';
          }
        });
        
        // Show "no results" message if needed
        showNoResultsMessage(!foundResults);
      }
      
      // Show/hide no results message
      function showNoResultsMessage(show) {
        let noResultsMsg = document.getElementById('no-results-message');
        
        if (show) {
          if (!noResultsMsg) {
            noResultsMsg = document.createElement('div');
            noResultsMsg.id = 'no-results-message';
            noResultsMsg.className = 'alert alert-info mt-3';
            noResultsMsg.innerHTML = '<i class="bi bi-info-circle"></i> No blog posts found matching your search. Try different keywords.';
            document.querySelector('.entries').appendChild(noResultsMsg);
          }
        } else {
          if (noResultsMsg) {
            noResultsMsg.remove();
          }
        }
      }
      
      // Handle form submission
      searchForm.addEventListener('submit', function(e) {
        e.preventDefault();
        performSearch(searchInput.value);
      });
      
      // Real-time search as user types (with debounce)
      let searchTimeout;
      searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          performSearch(this.value);
        }, 300);
      });
      
      // Clear search when input is cleared
      searchInput.addEventListener('keyup', function(e) {
        if (e.key === 'Escape') {
          this.value = '';
          performSearch('');
        }
      });
    });
  </script>

