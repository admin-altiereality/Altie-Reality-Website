<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  {{> sitehead}}
  <script type="application/ld+json">{{{jsonld schema}}}</script>
</head>

<body>
  {{> siteheader}}

  <main id="main">
    <section class="page-hero">
      <div class="container container--wide">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs">
            <li><a href="/">Home</a></li>
            <li>Products</li>
            <li>LearnXR™</li>
          </ol>
        </nav>

        <div class="split split--wide-text" style="margin-top: var(--s6);">
          <div>
            <p class="eyebrow">Flagship platform</p>
            <h1 class="display">LearnXR™</h1>
            <p class="lead" style="margin-top: var(--s6);">
              An XR + AI learning platform for schools and colleges. Interactive,
              self-paced and curriculum-aligned — delivered on Meta Quest 2 &amp; 3,
              Android devices and Cardboard VR.
            </p>

            <div class="pill-row" style="margin-top: var(--s7);">
              <span class="pill pill--accent">Meta Quest 2 &amp; 3</span>
              <span class="pill pill--accent">Android</span>
              <span class="pill pill--accent">Cardboard VR</span>
            </div>

            <div class="btn-row" style="margin-top: var(--s7);">
              <a class="btn btn--primary btn--lg" href="{{company.calendly}}" target="_blank" rel="noopener">
                Book a demo
              </a>
              <a class="btn btn--ghost btn--lg" href="https://learnxr.altiereality.com" target="_blank" rel="noopener">
                Visit LearnXR
              </a>
            </div>
          </div>

          <div>
            <div class="devices">
              <div class="device">
                <span class="device__caption">Lesson library</span>
                <img src="/assets/img/portfolio/portfolio-1.png"
                     alt="LearnXR app home screen listing free lessons and video XR lessons"
                     width="1587" height="2245" fetchpriority="high" />
              </div>
              <div class="device device--lead">
                <span class="device__caption">Lesson detail</span>
                <img src="/assets/img/portfolio/portfolio-2.png"
                     alt="LearnXR lesson detail screen for Curiosity on Mars"
                     width="1587" height="2245" fetchpriority="high" />
              </div>
              <div class="device">
                <span class="device__caption">Immersive scene</span>
                <img src="/assets/img/portfolio/portfolio-3.png"
                     alt="LearnXR immersive scene with a Cardboard VR toggle"
                     width="1587" height="2245" fetchpriority="high" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem -->
    <section class="section section--paper">
      <div class="container container--wide">
        <div class="split">
          <div data-reveal>
            <p class="eyebrow">The problem</p>
            <h2>Some things cannot be taught from a page.</h2>
            <p class="lead" style="margin-top: var(--s5);">
              A cross-section of a heart, the geometry of a molecule, the scale
              of a historical site — these are spatial ideas compressed into two
              dimensions, and something is lost every time.
            </p>
            <p style="margin-top: var(--s4);">
              Laboratories are expensive, field trips are rare, and the gap
              widens outside Tier 1 cities. LearnXR was built to close it with
              the hardware schools can actually obtain.
            </p>
          </div>

          <div data-reveal>
            <div class="frame frame--ratio-4-3">
              <img src="/images/education%202.webp" alt="Students learning with immersive technology" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="section">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Capabilities</p>
          <h2>What students and teachers get.</h2>
        </div>

        <div class="grid grid-4">
          {{#each learnxrFeatures}}
          <div class="card" data-reveal="stagger">
            <span class="card__index" style="margin-bottom: var(--s4);">{{num @index}}</span>
            <h3 style="font-size: 1.05rem;">{{this}}</h3>
          </div>
          {{/each}}
        </div>
      </div>
    </section>

    <!-- Platform pillars -->
    <section class="section section--raised">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Platform</p>
          <h2>Built to run in a real school, not a demo room.</h2>
        </div>

        <div class="cap-grid" data-reveal>
          {{#each learnxrPillars}}
          <div class="cap">
            <span class="cap__label">{{num @index}}</span>
            <h3>{{this.title}}</h3>
            <p>{{this.body}}</p>
          </div>
          {{/each}}
        </div>
      </div>
    </section>

    <!-- Teacher tooling -->
    <section class="section">
      <div class="container container--wide">
        <div class="split split--wide-text">
          <div data-reveal>
            <p class="eyebrow">Teacher tools</p>
            <h2>Classroom control, not just content.</h2>
            <p class="lead" style="margin-top: var(--s5);">
              Comprehensive tools for teachers to manage virtual classrooms and
              track student progress.
            </p>

            <ul class="checklist" style="margin-top: var(--s7);">
              <li>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Real-time monitoring of student activity and engagement during virtual sessions</span>
              </li>
              <li>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>An interface for creating and customising virtual lessons</span>
              </li>
              <li>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Detailed analytics and progress reports for each student</span>
              </li>
              <li>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Multi-user virtual classrooms for collaborative lessons</span>
              </li>
            </ul>
          </div>

          <div data-reveal>
            <div class="frame frame--ratio-4-3 frame--contain">
              <img src="/assets/img/portfolio/portfolio-11.png" alt="A LearnXR lesson screen showing scene count and lesson notes" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Availability -->
    <section class="section section--paper">
      <div class="container container--wide">
        <div class="section-head section-head--center" data-reveal>
          <p class="eyebrow">Availability</p>
          <h2>Live on the stores schools already use.</h2>
        </div>

        <div class="grid grid-3">
          {{#each product.links}}
          <a class="card card--link" href="{{this.url}}" target="_blank" rel="noopener noreferrer" data-reveal="stagger">
            <h3 style="font-size: 1.05rem;">{{this.label}}</h3>
            <p style="margin-top: var(--s3);">Open in a new tab</p>
            <span class="link-arrow" style="margin-top: var(--s5);">
              Go
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
          {{/each}}
        </div>
      </div>
    </section>

    <!-- Evidence -->
    <section class="section">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Recognition</p>
          <h2>Funded and validated by the programmes that matter.</h2>
          <p class="lead">
            LearnXR is funded by Meta Inc. through the Meta XR Startup Program in
            association with MeitY Startup Hub and FITT, IIT Delhi. Altie Reality
            is a startup recognised and funded by iStart Rajasthan and SPTBI Mumbai.
          </p>
        </div>

        <div class="grid grid-4">
          {{#each testimonials}}
          <article class="card quote" data-reveal="stagger">
            <blockquote>“{{this.quote}}”</blockquote>
            <div class="quote__who">
              <img src="{{this.image}}" alt="" loading="lazy" width="42" height="42" />
              <div>
                <div class="quote__name">{{this.name}}</div>
                <div class="quote__role">{{this.role}}</div>
              </div>
            </div>
          </article>
          {{/each}}
        </div>
      </div>
    </section>

    <section class="section section--flush-top">
      <div class="container container--wide">
        {{> ctaband}}
      </div>
    </section>
  </main>

  {{> sitefooter}}
</body>
</html>
