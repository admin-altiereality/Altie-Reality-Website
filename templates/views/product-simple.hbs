<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  {{> sitehead}}
  <script type="application/ld+json">{{{jsonld schema}}}</script>
</head>

<body>
  {{> siteheader}}

  <main id="main">
    <section class="page-hero">
      <div class="container container--wide">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs">
            <li><a href="/">Home</a></li>
            <li>Products</li>
            <li>{{product.name}}</li>
          </ol>
        </nav>

        <div class="split split--wide-text" style="margin-top: var(--s6);">
          <div>
            <p class="eyebrow">{{product.category}}</p>
            <h1 class="display">{{product.name}}</h1>
            <p class="lead" style="margin-top: var(--s6);">{{product.summary}}</p>
            <p style="margin-top: var(--s4);">{{product.blurb}}</p>

            <div class="btn-row" style="margin-top: var(--s7);">
              {{#if product.external}}
              <a class="btn btn--primary btn--lg" href="{{product.external}}" target="_blank" rel="noopener noreferrer">
                Open {{product.name}}
              </a>
              {{/if}}
              <a class="btn btn--ghost btn--lg" href="/contact">Talk to the team</a>
            </div>
          </div>

          <div>
            {{#if product.image}}
            <div class="frame frame--ratio-4-3">
              <img src="{{product.image}}" alt="{{product.name}} — {{product.summary}}" width="800" height="600" />
            </div>
            {{else}}
            <div class="plate">
              <span class="plate__cat">{{product.category}}</span>
              <span class="plate__name">{{product.name}}</span>
            </div>
            {{/if}}
          </div>
        </div>
      </div>
    </section>

    {{#if product.links}}
    <section class="section">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Where to find it</p>
          <h2>Available now.</h2>
        </div>
        <div class="grid grid-3">
          {{#each product.links}}
          <a class="card card--link" href="{{this.url}}" target="_blank" rel="noopener noreferrer" data-reveal="stagger">
            <h3 style="font-size: 1.05rem;">{{this.label}}</h3>
            <span class="link-arrow" style="margin-top: var(--s5);">
              Go
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
          {{/each}}
        </div>
      </div>
    </section>
    {{/if}}

    <section class="section section--raised">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">More from Altie Reality</p>
          <h2>The rest of the stack.</h2>
        </div>
        <div class="grid grid-4">
          {{#each products}}
          <a class="card card--link" href="{{this.href}}" data-reveal="stagger">
            <span class="card__index" style="margin-bottom: var(--s3);">{{this.category}}</span>
            <h3 style="font-size: 1.05rem;">{{this.name}}</h3>
            <p style="margin-top: var(--s3);">{{this.summary}}</p>
          </a>
          {{/each}}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--wide">
        {{> ctaband}}
      </div>
    </section>
  </main>

  {{> sitefooter}}
</body>
</html>
