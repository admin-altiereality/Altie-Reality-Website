      }
      
      .download-buttons-row {
        flex-direction: column;
        gap: 10px;
      }
      
      .btn-primary-cta {
        padding: 16px 35px !important;
        font-size: 16px !important;
      }
      
      .btn-secondary {
        padding: 10px 20px !important;
        font-size: 14px !important;
      }
    }
    
    /* Demo CTA box responsive styles */
    @media (max-width: 768px) {
      .demo-cta-box {
        padding: 1.5rem !important;
      }
      
      .demo-cta-box h3 {
        font-size: 1.5rem !important;
      }
      
      .demo-cta-box p {
        font-size: 0.9rem !important;
      }
    }
    
    /* Ensure scrolling always works */
    html, body {
      overflow-x: hidden !important;
    }
    
    body {
      overflow-y: auto !important;
    }
    
    /* Fix for any potential scroll blocking */
    body.scroll-disabled {
      overflow: hidden !important;
    }
    
    /* Ensure smooth scrolling restoration */
    html {
      scroll-behavior: smooth;
    }
  </style>

  <!-- Add this JavaScript for better touch feedback -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const clickableBoxes = document.querySelectorAll('.info-box.clickable');
      clickableBoxes.forEach(box => {
        box.addEventListener('touchstart', function() {
          this.style.opacity = '0.8';
        });
        box.addEventListener('touchend', function() {
          this.style.opacity = '1';
        });
      });
      
      // Floating demo button tooltip functionality
      const floatingBtn = document.querySelector('.floating-demo-btn');
      const tooltip = document.querySelector('.floating-tooltip');
      
      if (floatingBtn && tooltip) {
        floatingBtn.addEventListener('mouseenter', function() {
          tooltip.style.opacity = '1';
        });
        
        floatingBtn.addEventListener('mouseleave', function() {
          tooltip.style.opacity = '0';
        });
        
        // Hide tooltip on mobile touch
        floatingBtn.addEventListener('touchstart', function() {
          tooltip.style.opacity = '0';
        });
      }
    });
  </script>

</body>

</html>