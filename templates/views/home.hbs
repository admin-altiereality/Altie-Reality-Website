<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  {{> sitehead}}
  <script type="application/ld+json">{{{jsonld schema}}}</script>
</head>

<body>
  {{> siteheader}}

  <main id="main">
    <!-- ================= HERO ================= -->
    <section class="hero">
      <div class="hero__backdrop" aria-hidden="true"></div>
      <canvas class="hero__canvas" id="hero-field" aria-hidden="true"></canvas>

      <div class="container container--wide">
        <div class="hero__inner">
          <p class="eyebrow">Altie Reality — a metaverse company</p>

          <h1>
            We build immersive worlds you can
            <em>step into</em>.
          </h1>

          <p class="hero__lead">
            Extended reality experiences built for Meta Quest — from
            curriculum-aligned classrooms that put students inside the subject,
            to navigable digital twins of real environments.
          </p>

          <div class="btn-row">
            <a class="btn btn--primary btn--lg" href="https://learnxr.altiereality.com" target="_blank" rel="noopener noreferrer">
              Explore LearnXR™
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a class="btn btn--ghost btn--lg" href="{{company.calendly}}" target="_blank" rel="noopener">
              Book a demo
            </a>
          </div>

          <div class="hero__meta">
            <span class="mono-label">Backed &amp; recognised by</span>
            <span class="mono-label" style="color: var(--text-2);">Meta&nbsp;XR Startup Program</span>
            <span class="mono-label" style="color: var(--text-2);">MeitY&nbsp;Startup Hub</span>
            <span class="mono-label" style="color: var(--text-2);">FITT,&nbsp;IIT Delhi</span>
            <span class="mono-label" style="color: var(--text-2);">iStart&nbsp;Rajasthan</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= INSIDE THE WORK ================= -->
    <section class="section section--tight section--raised">
      <div class="container container--wide">
        <div class="split split--wide-text">
          <div data-reveal>
            <p class="eyebrow">Inside the studio</p>
            <h2>Headsets on, every day.</h2>
            <p class="lead" style="margin-top: var(--s5);">
              We build and test in the same hardware our users wear. Every
              experience we ship has been walked through in a headset before it
              reaches a classroom or a client.
            </p>
            <div class="btn-row" style="margin-top: var(--s7);">
              <a class="link-arrow" href="/company">
                About the company
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                  <path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>

          <div data-reveal>
            <div class="frame frame--ratio-16-9">
              <img
                src="/media/assets/img/teamabout.webp"
                alt="The Altie Reality team building and testing in Meta Quest headsets"
                loading="lazy" width="1600" height="898"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= RECOGNITION ================= -->
    <section class="section section--tight">
      <div class="container container--wide">
        <div class="section-head" data-reveal style="margin-bottom: var(--s7);">
          <p class="eyebrow">Institutional backing</p>
          <h2>Recognised by the programmes building India's XR sector.</h2>
        </div>

        <div class="recog" data-reveal>
          {{#each recognition}}
          {{#if this.href}}
          <a class="recog__item" href="{{this.href}}" target="_blank" rel="noopener noreferrer">
            <img class="recog__logo" src="{{this.image}}" alt="{{this.name}}" loading="lazy" width="130" height="74" />
            <span class="recog__name">{{this.name}}</span>
            <span class="recog__note">{{this.note}}</span>
          </a>
          {{else}}
          <div class="recog__item">
            <img class="recog__logo" src="{{this.image}}" alt="{{this.name}}" loading="lazy" width="130" height="74" />
            <span class="recog__name">{{this.name}}</span>
            <span class="recog__note">{{this.note}}</span>
          </div>
          {{/if}}
          {{/each}}
        </div>
      </div>
    </section>

    <!-- ================= WHAT WE BUILD ================= -->
    <section class="section section--paper" id="solutions">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">What we build</p>
          <h2>Two things, built properly.</h2>
          <p class="lead">
            An immersive learning platform, and digital twins of real
            environments. Both delivered through the headset.
          </p>
        </div>

        <div>
          {{#each products}}
          <article class="product-row" data-reveal>
            <div class="product-row__body">
              <p class="eyebrow">{{this.category}}</p>
              <h3 style="font-size: var(--t-h2);">{{this.name}}</h3>
              <p class="lead" style="margin-top: var(--s4);">{{this.summary}}</p>
              <p style="margin-top: var(--s4);">{{this.blurb}}</p>

              <div class="btn-row" style="margin-top: var(--s6);">
                <a class="btn btn--primary" href="{{this.href}}" target="_blank" rel="noopener noreferrer">
                  Visit {{this.name}}
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M4 2h6v6M10 2 3 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </div>

            <div class="product-row__media">
              <div class="frame frame--ratio-4-3">
                <img src="{{this.image}}" alt="{{this.imageAlt}}" loading="lazy" />
              </div>
            </div>
          </article>
          {{/each}}
        </div>
      </div>
    </section>

    <!-- ================= TECHNOLOGY ================= -->
    <section class="section" id="technology">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Technology</p>
          <h2>The capabilities behind both.</h2>
          <p class="lead">
            We work across the immersive stack — headset applications,
            real-time 3D, applied AI, multi-user environments and the input
            hardware that makes any of it usable.
          </p>
        </div>

        <div class="cap-grid" data-reveal>
          {{#each capabilities}}
          <div class="cap">
            <span class="cap__label">{{this.label}}</span>
            <h3>{{this.title}}</h3>
            <p>{{this.body}}</p>
          </div>
          {{/each}}
        </div>

        <div style="margin-top: var(--s7);" data-reveal>
          <a class="link-arrow" href="/technology">
            How we build
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= INDUSTRIES ================= -->
    <section class="section section--raised">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Where it is applied</p>
          <h2>Seven sectors, one set of spatial primitives.</h2>
        </div>

        <div class="grid grid-3">
          {{#each industries}}
          <a
            class="card card--link card--media{{#if @last}} card--wide{{/if}}"
            href="{{this.route}}"
            data-reveal="stagger"
          >
            <div class="card__media">
              <img src="{{this.image}}" alt="{{this.imageAlt}}" loading="lazy" />
            </div>
            <div class="card__body">
              <span class="card__index" style="margin-bottom: var(--s2);">{{this.eyebrow}}</span>
              <h3>{{this.name}}</h3>
              <p>{{this.title}}</p>
            </div>
          </a>
          {{/each}}
        </div>
      </div>
    </section>

    <!-- ================= JOURNEY ================= -->
    <section class="section section--paper">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Journey</p>
          <h2>From a Meta accelerator seat to European stages.</h2>
          <p class="lead">
            Selected milestones. Every entry is an event we took part in, a
            programme that selected us, or a product we shipped.
          </p>
        </div>

        <div class="grid grid-2" style="gap: var(--s5);">
          {{#each featured}}
          <article class="card" data-reveal="stagger">
            <div class="entry__meta">
              <span class="pill">{{this.kind}}</span>
              <span class="entry__date">{{this.date}}</span>
            </div>
            <h3>{{this.title}}</h3>
            <p style="margin-top: var(--s3);">{{this.summary}}</p>
          </article>
          {{/each}}
        </div>

        <div style="margin-top: var(--s8);" data-reveal>
          <a class="btn btn--ghost" href="/blog">Read the full journey</a>
        </div>
      </div>
    </section>

    <!-- ================= VOICES ================= -->
    <section class="section section--raised">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">In their words</p>
          <h2>What learners and educators tell us.</h2>
        </div>

        <div class="grid grid-4">
          {{#each testimonials}}
          <article class="card quote" data-reveal="stagger">
            <blockquote>“{{this.quote}}”</blockquote>
            <div class="quote__who">
              <img src="{{this.image}}" alt="" loading="lazy" width="42" height="42" />
              <div>
                <div class="quote__name">{{this.name}}</div>
                <div class="quote__role">{{this.role}}</div>
              </div>
            </div>
          </article>
          {{/each}}
        </div>
      </div>
    </section>

    <!-- ================= TEAM ================= -->
    <section class="section">
      <div class="container container--wide">
        <div class="split split--wide-text">
          <div data-reveal>
            <p class="eyebrow">Company</p>
            <h2>A small team with an engineering bias.</h2>
            <p class="lead" style="margin-top: var(--s5);">
              Altie Reality was founded in Jaipur and builds immersive products
              for education, enterprise and culture.
            </p>

            <ul class="people" style="margin-top: var(--s7);">
              {{#each team}}
              <li class="people__row">
                <span class="people__name">{{this.name}}</span>
                <span class="people__role">{{this.role}}</span>
                <span class="people__cred">{{this.credential}}</span>
              </li>
              {{/each}}
            </ul>

            <div class="btn-row" style="margin-top: var(--s7);">
              <a class="btn btn--ghost" href="/company">About the company</a>
              <a class="btn btn--ghost" href="/career">Open roles</a>
            </div>
          </div>

          <div data-reveal>
            <div class="frame frame--ratio-4-3">
              <img
                src="/media/images/avgcxr.webp"
                alt="The Altie Reality team hosting AVGC-XR stakeholders in Jaipur"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    {{> contactsection}}
  </main>

  {{> sitefooter}}
  <script src="/design/hero.js?v={{v}}" defer></script>
</body>
</html>
