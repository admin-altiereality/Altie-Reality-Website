<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  {{> sitehead}}
  <script type="application/ld+json">{{{jsonld schema}}}</script>
</head>

<body>
  {{> siteheader}}

  <main id="main">
    <!-- ================= HERO ================= -->
    <section class="hero">
      <div class="hero__backdrop" aria-hidden="true"></div>
      <canvas class="hero__canvas" id="hero-field" aria-hidden="true"></canvas>

      <div class="container container--wide">
        <div class="hero__inner">
          <p class="eyebrow">Altie Reality — Jaipur, India</p>

          <h1>
            We build the products and hardware of the
            <em>spatial computing era</em>.
          </h1>

          <p class="hero__lead">
            Altie Reality is an XR company building immersive learning platforms,
            interaction hardware and enterprise simulation — shipping on Meta
            Quest, Android and the web. Our flagship platform, LearnXR™, brings
            curriculum-aligned XR + AI learning to classrooms across Tier 1, 2
            and 3 cities.
          </p>

          <div class="btn-row">
            <a class="btn btn--primary btn--lg" href="/products/learnxr">
              Explore LearnXR™
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a class="btn btn--ghost btn--lg" href="{{company.calendly}}" target="_blank" rel="noopener">
              Book a demo
            </a>
          </div>

          <div class="hero__meta">
            <span class="mono-label">Backed &amp; recognised by</span>
            <span class="mono-label" style="color: var(--text-2);">Meta&nbsp;XR Startup Program</span>
            <span class="mono-label" style="color: var(--text-2);">MeitY&nbsp;Startup Hub</span>
            <span class="mono-label" style="color: var(--text-2);">FITT,&nbsp;IIT Delhi</span>
            <span class="mono-label" style="color: var(--text-2);">iStart&nbsp;Rajasthan</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= RECOGNITION ================= -->
    <section class="section section--tight section--raised">
      <div class="container container--wide">
        <div class="section-head" data-reveal style="margin-bottom: var(--s7);">
          <p class="eyebrow">Institutional backing</p>
          <h2>Recognised by the programmes building India's XR sector.</h2>
        </div>

        <div class="recog" data-reveal>
          {{#each recognition}}
          {{#if this.href}}
          <a class="recog__item" href="{{this.href}}" target="_blank" rel="noopener noreferrer">
            <img class="recog__logo" src="{{this.image}}" alt="{{this.name}}" loading="lazy" width="130" height="34" />
            <span class="recog__name">{{this.name}}</span>
            <span class="recog__note">{{this.note}}</span>
          </a>
          {{else}}
          <div class="recog__item">
            <img class="recog__logo" src="{{this.image}}" alt="{{this.name}}" loading="lazy" width="130" height="34" />
            <span class="recog__name">{{this.name}}</span>
            <span class="recog__note">{{this.note}}</span>
          </div>
          {{/if}}
          {{/each}}
        </div>
      </div>
    </section>

    <!-- ================= WHAT WE BUILD ================= -->
    <section class="section section--paper" id="products">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">What we build</p>
          <h2>Five products, one immersive stack.</h2>
          <p class="lead">
            A learning platform, the hardware that drives it, and the studio
            practice that extends it into enterprise, culture and entertainment.
          </p>
        </div>

        <div>
          {{#each products}}
          <article class="product-row" data-reveal>
            <div class="product-row__body">
              <p class="eyebrow">{{this.category}}</p>
              <h3 style="font-size: var(--t-h2);">{{this.name}}</h3>
              <p class="lead" style="margin-top: var(--s4);">{{this.summary}}</p>
              <p style="margin-top: var(--s4);">{{this.blurb}}</p>

              <div class="btn-row" style="margin-top: var(--s6);">
                <a class="link-arrow" href="{{this.href}}">
                  Explore {{this.name}}
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                    <path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </div>

            <div class="product-row__media">
              {{#if this.image}}
              <div class="frame {{#if this.imageFit}}frame--contain frame--portrait{{else}}frame--ratio-4-3{{/if}}">
                <img src="{{this.image}}" alt="{{this.name}} — {{this.summary}}" loading="lazy" />
              </div>
              {{else}}
              <div class="plate">
                <span class="plate__cat">{{this.category}}</span>
                <span class="plate__name">{{this.name}}</span>
              </div>
              {{/if}}
            </div>
          </article>
          {{/each}}
        </div>
      </div>
    </section>

    <!-- ================= LEARNXR SHOWCASE ================= -->
    <section class="section">
      <div class="container container--wide">
        <div class="split split--wide-text">
          <div data-reveal>
            <p class="eyebrow">Flagship platform</p>
            <h2>LearnXR™ turns a classroom into a laboratory.</h2>
            <p class="lead" style="margin-top: var(--s5);">
              Curriculum-aligned lessons students can walk into. Virtual science
              labs, 3D geometry, immersive history — delivered on the headsets
              and phones schools already have, with the analytics teachers need
              behind them.
            </p>

            <ul class="checklist" style="margin-top: var(--s7);">
              {{#each learnxrFeatures}}
              <li>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{{this}}</span>
              </li>
              {{/each}}
            </ul>

            <div class="btn-row" style="margin-top: var(--s8);">
              <a class="btn btn--primary" href="/products/learnxr">See the platform</a>
              <a class="btn btn--ghost" href="https://learnxr.altiereality.com" target="_blank" rel="noopener">
                learnxr.altiereality.com
              </a>
            </div>
          </div>

          <div data-reveal>
            <div class="devices">
              <div class="device">
                <span class="device__caption">Lesson library</span>
                <img
                  src="/media/assets/img/portfolio/portfolio-1.webp"
                  alt="LearnXR app home screen listing free lessons and video XR lessons"
                  loading="lazy" width="1587" height="2245"
                />
              </div>
              <div class="device device--lead">
                <span class="device__caption">Lesson detail</span>
                <img
                  src="/media/assets/img/portfolio/portfolio-2.webp"
                  alt="LearnXR lesson detail screen for Curiosity on Mars"
                  loading="lazy" width="1587" height="2245"
                />
              </div>
              <div class="device">
                <span class="device__caption">Immersive scene</span>
                <img
                  src="/media/assets/img/portfolio/portfolio-3.webp"
                  alt="LearnXR immersive scene with a Cardboard VR toggle"
                  loading="lazy" width="1587" height="2245"
                />
              </div>
            </div>

            <div class="pill-row" style="margin-top: var(--s6);">
              <span class="pill pill--accent">Meta Quest 2 &amp; 3</span>
              <span class="pill pill--accent">Android</span>
              <span class="pill pill--accent">Cardboard VR</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= TECHNOLOGY ================= -->
    <section class="section section--raised" id="technology">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Technology</p>
          <h2>The capabilities behind every product we ship.</h2>
          <p class="lead">
            We work across the immersive stack — headset and handheld
            applications, real-time 3D, applied AI, and the input hardware that
            makes any of it usable in a classroom.
          </p>
        </div>

        <div class="cap-grid" data-reveal>
          {{#each capabilities}}
          <div class="cap">
            <span class="cap__label">{{this.label}}</span>
            <h3>{{this.title}}</h3>
            <p>{{this.body}}</p>
          </div>
          {{/each}}
        </div>

        <div style="margin-top: var(--s7);" data-reveal>
          <a class="link-arrow" href="/technology">
            How we build
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= SOLUTIONS ================= -->
    <section class="section">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Where it is applied</p>
          <h2>Seven sectors, one set of spatial primitives.</h2>
        </div>

        <div class="grid grid-3">
          {{#each industries}}
          <a
            class="card card--link card--media{{#if @last}} card--wide{{/if}}"
            href="{{this.route}}"
            data-reveal="stagger"
          >
            <div class="card__media">
              <img src="{{this.image}}" alt="{{this.imageAlt}}" loading="lazy" />
            </div>
            <div class="card__body">
              <span class="card__index" style="margin-bottom: var(--s2);">{{this.eyebrow}}</span>
              <h3>{{this.name}}</h3>
              <p>{{this.title}}</p>
            </div>
          </a>
          {{/each}}
        </div>
      </div>
    </section>

    <!-- ================= JOURNEY ================= -->
    <section class="section section--paper">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Journey</p>
          <h2>From a Meta accelerator seat to European stages.</h2>
          <p class="lead">
            Selected milestones from {{company.founded}} onward. Every entry is
            an event we took part in, a programme that selected us, or a product
            we shipped.
          </p>
        </div>

        <div class="grid grid-2" style="gap: var(--s5);">
          {{#each featured}}
          <article class="card" data-reveal="stagger">
            <div class="entry__meta">
              <span class="pill">{{this.kind}}</span>
              <span class="entry__date">{{this.date}}</span>
            </div>
            <h3>{{this.title}}</h3>
            <p style="margin-top: var(--s3);">{{this.summary}}</p>
          </article>
          {{/each}}
        </div>

        <div style="margin-top: var(--s8);" data-reveal>
          <a class="btn btn--ghost" href="/blog">Read the full journey</a>
        </div>
      </div>
    </section>

    <!-- ================= VOICES ================= -->
    <section class="section">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">In their words</p>
          <h2>What learners and educators tell us.</h2>
        </div>

        <div class="grid grid-4">
          {{#each testimonials}}
          <article class="card quote" data-reveal="stagger">
            <blockquote>“{{this.quote}}”</blockquote>
            <div class="quote__who">
              <img src="{{this.image}}" alt="" loading="lazy" width="42" height="42" />
              <div>
                <div class="quote__name">{{this.name}}</div>
                <div class="quote__role">{{this.role}}</div>
              </div>
            </div>
          </article>
          {{/each}}
        </div>
      </div>
    </section>

    <!-- ================= TEAM ================= -->
    <section class="section section--raised">
      <div class="container container--wide">
        <div class="split split--wide-text">
          <div data-reveal>
            <p class="eyebrow">Company</p>
            <h2>A small team with an engineering bias.</h2>
            <p class="lead" style="margin-top: var(--s5);">
              Altie Reality was founded in Jaipur and operates from Bhamashah
              Technohub. We build immersive products for education, enterprise
              and culture — and the hardware that makes them usable.
            </p>
            <div class="btn-row" style="margin-top: var(--s7);">
              <a class="btn btn--ghost" href="/company">About the company</a>
              <a class="btn btn--ghost" href="/career">Open roles</a>
            </div>
          </div>

          <div class="grid grid-3" style="gap: var(--s5);" data-reveal>
            {{#each team}}
            <div class="person">
              <div class="person__photo">
                <img src="{{this.image}}" alt="{{this.name}}, {{this.role}}" loading="lazy" />
              </div>
              <h3 style="font-size: 1rem;">{{this.name}}</h3>
              <span class="person__role">{{this.role}}</span>
              <p class="person__cred">{{this.credential}}</p>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    {{> contactsection}}
  </main>

  {{> sitefooter}}
  <script src="/design/hero.js?v={{v}}" defer></script>
</body>
</html>
