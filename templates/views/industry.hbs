<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  {{> sitehead}}
  <script type="application/ld+json">{{{jsonld schema}}}</script>
</head>

<body>
  {{> siteheader}}

  <main id="main">
    <section class="page-hero">
      <div class="container container--wide">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs">
            <li><a href="/">Home</a></li>
            <li>Solutions</li>
            <li>{{industry.name}}</li>
          </ol>
        </nav>

        <div class="split split--wide-text" style="margin-top: var(--s6);">
          <div>
            <p class="eyebrow">{{industry.eyebrow}}</p>
            <h1>{{industry.title}}</h1>
          </div>
          <div>
            <div class="frame frame--ratio-4-3">
              <img src="{{industry.image}}" alt="{{industry.imageAlt}}" width="800" height="600" fetchpriority="high" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--flush-top">
      <div class="container container--wide">
        <div class="split" style="align-items: start;">
          <div data-reveal>
            <p class="lead">{{industry.lead}}</p>

            {{#if related}}
            <div style="margin-top: var(--s8); padding: var(--s6); border: 1px solid var(--line); border-radius: var(--r-lg); background: rgba(91,124,255,0.05);">
              <p class="eyebrow">Related product</p>
              <h3>{{related.name}}</h3>
              <p style="margin-top: var(--s3); color: var(--text-2);">{{related.summary}}</p>
              <a class="link-arrow" href="{{related.href}}" style="margin-top: var(--s5);">
                Explore {{related.name}}
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
            {{/if}}
          </div>

          <div data-reveal>
            <p class="eyebrow">Use cases</p>
            <ul class="checklist" style="margin-top: var(--s5);">
              {{#each industry.useCases}}
              <li>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5L8 14.5L16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{{this}}</span>
              </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Why it works</p>
          <h2>Benefits of mixed reality in {{industry.name}}.</h2>
        </div>

        <div class="grid grid-2">
          {{#each industry.benefits}}
          <article class="card" data-reveal="stagger">
            <span class="card__index">{{num @index}}</span>
            <h3>{{this.title}}</h3>
            <p style="margin-top: var(--s3);">{{this.body}}</p>
          </article>
          {{/each}}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Other sectors</p>
          <h2>The same primitives, applied elsewhere.</h2>
        </div>

        <div class="grid grid-3">
          {{#each others}}
          <a class="card card--link card--media" href="{{this.route}}" data-reveal="stagger">
            <div class="card__media">
              <img src="{{this.image}}" alt="{{this.imageAlt}}" loading="lazy" />
            </div>
            <div class="card__body">
              <span class="card__index" style="margin-bottom: var(--s2);">{{this.eyebrow}}</span>
              <h3 style="font-size: 1.1rem;">{{this.name}}</h3>
            </div>
          </a>
          {{/each}}
        </div>

        <div style="margin-top: var(--s10);">
          {{> ctaband glass=true}}
        </div>
      </div>
    </section>
  </main>

  {{> sitefooter}}
</body>
</html>
