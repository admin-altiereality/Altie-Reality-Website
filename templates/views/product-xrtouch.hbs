<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  {{> sitehead}}
  <script type="application/ld+json">{{{jsonld schema}}}</script>
</head>

<body>
  {{> siteheader}}

  <main id="main">
    <section class="page-hero">
      <div class="container container--wide">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs">
            <li><a href="/">Home</a></li>
            <li>Products</li>
            <li>XRtouch</li>
          </ol>
        </nav>

        <div class="split split--wide-text" style="margin-top: var(--s6);">
          <div>
            <p class="eyebrow">Hardware</p>
            <h1 class="display">XRtouch</h1>
            <p class="lead" style="margin-top: var(--s6);">
              A handheld accessory that, coupled with a head-mounted display,
              lets users interact with and navigate a virtual or augmented
              environment through buttons, sensors, haptic feedback and gesture
              recognition.
            </p>
            <p style="margin-top: var(--s4);">
              Wireless, ergonomic and tailored to specific XR platforms — built
              for a more natural user experience.
            </p>

            <div class="btn-row" style="margin-top: var(--s7);">
              <a class="btn btn--primary btn--lg" href="{{company.calendly}}" target="_blank" rel="noopener">
                Request a demo
              </a>
              <a class="btn btn--ghost btn--lg" href="/contact">Talk to the team</a>
            </div>
          </div>

          <div>
            <div class="frame frame--ratio-4-3">
              <img src="/images/hardware.jpg" alt="XRtouch hardware prototype" width="800" height="600" fetchpriority="high" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Capabilities</p>
          <h2>Built for direct manipulation.</h2>
        </div>

        <div class="grid grid-3">
          {{#each xrtouchFeatures}}
          <article class="card" data-reveal="stagger">
            <div class="frame frame--ratio-16-9" style="margin: calc(-1 * clamp(1.5rem, 2.4vw, 2rem)) calc(-1 * clamp(1.5rem, 2.4vw, 2rem)) clamp(1.5rem, 2.4vw, 2rem); border-radius: var(--r-lg) var(--r-lg) 0 0; border-width: 0 0 1px 0;">
              <img src="{{this.image}}" alt="{{this.title}}" loading="lazy" />
            </div>
            <h3>{{this.title}}</h3>
            <p style="margin-top: var(--s3);">{{this.body}}</p>
          </article>
          {{/each}}
        </div>
      </div>
    </section>

    <section class="section section--paper">
      <div class="container container--wide">
        <div class="split">
          <div data-reveal>
            <p class="eyebrow">Funding</p>
            <h2>Developed under a NIDHI PRAYAS grant.</h2>
            <p class="lead" style="margin-top: var(--s5);">
              We are grateful to SPTBI Mumbai for their grant under NIDHI PRAYAS,
              an initiative by the Department of Science and Technology,
              Government of India, which has been instrumental in developing the
              XRtouch hardware prototype.
            </p>
            <p style="margin-top: var(--s4);">
              The tool is designed to change how users interact with virtual and
              augmented realities, offering a high level of immersion and
              intuitive control.
            </p>
          </div>

          <div data-reveal>
            <div class="frame frame--contain frame--ratio-16-9">
              <img src="/images/sptbilogo.png" alt="SPTBI Mumbai" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--wide">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Use cases</p>
          <h2>Where XRtouch is applied.</h2>
        </div>

        <div class="pill-row" data-reveal>
          {{#each xrtouchUseCases}}
          <span class="pill" style="font-size: 0.82rem; padding: 0.6rem 1.1rem;">{{this}}</span>
          {{/each}}
        </div>

        <div class="split" style="margin-top: var(--s10);">
          <div data-reveal>
            <h3>Works with LearnXR</h3>
            <p class="lead" style="margin-top: var(--s4);">
              The XRtouch controller works with the LearnXR app on both Android
              and iOS devices. Connect your smartphone to the controller to start
              using immersive content.
            </p>
            <div class="btn-row" style="margin-top: var(--s6);">
              <a class="link-arrow" href="/products/learnxr">
                Explore LearnXR™
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M9 1L13 5L9 9M13 5H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <div data-reveal>
            <div class="frame frame--ratio-16-9">
              <img src="/images/wid%20phn.jpg" alt="XRtouch controller used with a smartphone-based headset" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--flush-top">
      <div class="container container--wide">
        {{> ctaband}}
      </div>
    </section>
  </main>

  {{> sitefooter}}
</body>
</html>
