{
  "name": "altie-reality-website",
  "version": "1.0.0",
  "description": "Altie Reality \u2014 corporate website (Express + Handlebars)",
  "main": "app.js",
  "scripts": {
    "start": "nodemon -e js,html,hbs,css app.js",
    "dev": "nodemon -e js,html,hbs,css app.js",
    "media": "node scripts/optimize-media.js && node scripts/make-og.js && node scripts/make-carousel.js",
    "check:site": "node scripts/check-site.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:responsive": "node scripts/shoot.js",
    "check:interactions": "node scripts/check-interactions.js",
    "check": "node scripts/check-contrast.js && node scripts/check-site.js && node scripts/shoot.js && node scripts/check-interactions.js && node scripts/check-hero.js",
    "build": "node scripts/prerender.js --site-url=https://altiereality.com",
    "deploy": "npm run build && firebase deploy --only hosting:lexrn1,functions:site --project lexrn1",
    "check:hero": "node scripts/check-hero.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.0.1",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^6.12.0",
    "google-auth-library": "^6.1.3",
    "hbs": "^4.1.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^5.12.13",
    "nodemailer": "^6.6.3",
    "nodemailer-sendgrid-transport": "^0.2.0",
    "nodemon": "^2.0.12",
    "serve-favicon": "^2.5.0",
    "socket.io": "^4.4.1"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "puppeteer-core": "^25.8.0",
    "uglify-js": "^3.19.3"
  }
}
